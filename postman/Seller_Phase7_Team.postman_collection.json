                "v1",
                "customer",
                "auth",
                "verify-otp"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{owner_email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
