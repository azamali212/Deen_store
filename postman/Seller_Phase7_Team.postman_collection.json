                  "const first = pm.response.json().data[0];",
                  "if (first) { pm.collectionVariables.set('member_id', first.id); console.log('invitation member_id = ' + first.id); }",
                  "else { console.log('No pending invitations for this account.'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Accept the invitation",
