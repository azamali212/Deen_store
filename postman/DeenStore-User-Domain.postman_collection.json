{
  "info": {
    "name": "Deen Store - User Domain",
    "description": "Self-service (Profile/Avatar/Addresses/Preferences) + Admin (User Management) endpoints for the User domain.\n\nSETUP FIRST:\n1. Login via the existing Auth endpoints (routes/auth/*.php) to get a Sanctum token \u2014 these require a captcha_token, so login through the app or Postman against /v1/{panel}/auth/login manually first.\n2. Paste the resulting token into the collection variable `token` (for self-service requests) and `admin_token` (for the Admin folder, must belong to a super_admin/admin user).\n3. Set `base_url` to your local server, e.g. http://localhost:8000/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "profile"
              ],
              "query": []
            },
            "description": "Returns null data if the profile hasn't been created yet."
          },
          "response": []
        },
        {
          "name": "Create / Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "profile"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"azam_ali\",\n    \"date_of_birth\": \"1998-05-14\",\n    \"gender\": \"male\",\n    \"bio\": \"Laravel developer building Deen Store.\",\n    \"website_url\": \"https://example.com\",\n    \"occupation\": \"Software Engineer\",\n    \"company_name\": \"Deen Store\",\n    \"country_code\": \"PK\",\n    \"timezone\": \"Asia/Karachi\",\n    \"locale\": \"en\",\n    \"profile_visibility\": \"public\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
