            "description": "Body type: form-data. Attach an image file under the 'avatar' key (jpg/jpeg/png/webp, max 5MB).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
