{
  "info": {
    "_postman_id": "494a8849-2daa-43c7-b715-a2785b25c9c1",
    "name": "Zimal Store — Seller Onboarding (Phase 2: Customer)",
    "description": "Phase 2 manual test for the customer side of seller onboarding.\n\nRUN ORDER:\n0) Get a token (either A: password login + OTP, or B: Google login).\n1) Run folder '1. Happy path' top to bottom.\n2) Run folder '2. Error cases' — each request says what it should return.\n\nBefore you start: php artisan migrate, and keep `php artisan queue:work` running (admin emails + audit rows are queued).\nEvery request sends Accept: application/json — without it a 401 turns into a redirect/500.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://zimal-store.test"
    },
    {
      "key": "customer_email",
      "value": "customer@example.com"
    },
    {
      "key": "customer_password",
      "value": "Password@123"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Get token (customer)",
      "item": [
        {
          "name": "A1. Customer login (sends OTP email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "login"
              ]
            },
            "description": "Sends a 6-digit OTP to the email. Set customer_email / customer_password in the collection variables first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2. Verify OTP (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Replace 123456 with the code from the email. The token is saved to {{token}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{customer_email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json && json.data ? json.data.token : null;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token saved to collection variable {{token}}');",
                  "} else {",
                  "    console.log('No token in response (OTP / 2FA step pending?)');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "B. Google login (alternative, saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/login/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "login",
                "google"
              ]
            },
            "description": "Get a fresh id_token from http://zimal-store.test/google-test.html (valid ~1 hour).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"PASTE_ID_TOKEN_FROM_google-test.html\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json && json.data ? json.data.token : null;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token saved to collection variable {{token}}');",
                  "} else {",
                  "    console.log('No token in response (OTP / 2FA step pending?)');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
