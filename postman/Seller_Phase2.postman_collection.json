            "description": "business_type: sole_proprietor | partnership | company. Response: status=draft, missing_documents lists all 5. accept_document_processing must be true (Phase 5 consent).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_name\": \"Zimal Fabrics\",\n  \"business_name\": \"Zimal Fabrics Pvt Ltd\",\n  \"business_type\": \"company\",\n  \"accept_document_processing\": true\n}",
