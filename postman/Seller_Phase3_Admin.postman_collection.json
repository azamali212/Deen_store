{
  "info": {
    "_postman_id": "5df452fb-711d-465a-9a88-9a8a4150f3aa",
    "name": "Zimal Store — Seller Onboarding (Phase 3: Admin Review)",
    "description": "Phase 3 manual test — admin side.\n\nBEFORE: you need at least one PENDING application (run the Phase 2 collection with a CUSTOMER account up to '6. Submit'). The reviewing admin must be a DIFFERENT account than the applicant — an admin can't review their own application (403).\n\nRUN ORDER: 0 (admin token) -> 1 (list, sets application_id automatically) -> 2 (detail + downloads) -> 3 (review: run EITHER approve OR reject) -> 4 (error cases).\nKeep `php artisan queue:work` running to see the applicant's email + audit rows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_email",
      "value": "azamalifsd73@gmail.com"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "application_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Admin token",
      "item": [
        {
          "name": "A1. Admin login (sends OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Set admin_email / admin_password in the collection Variables first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2. Verify admin OTP (saves admin_token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Replace 123456 with the OTP from the email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{admin_email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json && json.data ? json.data.token : null;",
                  "if (token) { pm.collectionVariables.set('admin_token', token); console.log('admin_token saved'); }",
                  "else { console.log('No token yet — if requires_two_factor is true, run A3 next.'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A3. Two-factor verify (ONLY if A2 said requires_two_factor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/two-factor/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "two-factor",
                "verify"
              ]
            },
            "description": "Only needed if 2FA is enabled on the admin account. Code = 6 digits from the authenticator app.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{admin_email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json && json.data ? json.data.token : null;",
                  "if (token) { pm.collectionVariables.set('admin_token', token); console.log('admin_token saved'); }",
                  "else { console.log('No token yet — if requires_two_factor is true, run A3 next.'); }"
                ]
              }
            }
          ]
        }
      ]
