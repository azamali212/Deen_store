              ],
              "path": [
                "api",
                "v1",
                "admin",
                "seller-applications",
                "{{application_id}}",
                "review"
              ]
            },
            "description": "status=rejected, reason saved + emailed. The customer can then fix and resubmit (Phase 2 collection: re-upload + 6. Submit).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"CNIC back side is blurry, please upload a clear photo.\"\n}",
              "options": {
                "raw": {
