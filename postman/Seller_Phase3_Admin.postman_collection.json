    {
      "name": "3. Review (run ONE of these)",
      "item": [
        {
          "name": "3a. APPROVE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/seller-applications/{{application_id}}/review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "seller-applications",
                "{{application_id}}",
                "review"
              ]
            },
            "description": "status=approved, seller_profiles row created, applicant gets 'seller' role (keeps 'customer'), approval email sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Approved', () => pm.expect(pm.response.json().data.status).to.eql('approved'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3b. REJECT (with reason)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
