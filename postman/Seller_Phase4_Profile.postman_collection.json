            "url": {
              "raw": "{{base_url}}/api/v1/seller/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile"
              ]
            },
            "description": "description goes through AI moderation (like the profile bio); address does not.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Hand-made lawn and cotton fabrics, shipped across Pakistan.\",\n  \"business_address\": \"Shop 12, Liberty Market, Lahore\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
