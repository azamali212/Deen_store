{
  "info": {
    "_postman_id": "f5a198bb-4956-4079-bc40-d761ecaa3f52",
    "name": "Zimal Store — Seller Onboarding (Phase 4: Seller Profile)",
    "description": "Phase 4 manual test — the APPROVED seller manages their business.\n\nBEFORE: the applicant's application must be APPROVED (Phase 3 collection, 3a).\nTOKEN: the applicant's CUSTOMER token from Phase 2 works here too — after approval the same account has the seller role, and the seller routes check the permission, not which login issued the token (blueprint C11, 'Switch to Seller Dashboard'). Paste it into {{token}}, or log in again with folder 0.\n\nKeep `php artisan queue:work` running to receive the bank-change email and see audit rows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "seller_email",
      "value": "azam.ayub62@yahoo.com"
    },
    {
      "key": "seller_password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Token (skip if you still have the Phase 2 customer token)",
      "item": [
        {
          "name": "A1. Login (sends OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{seller_email}}\",\n  \"password\": \"{{seller_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2. Verify OTP (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Replace 123456 with the emailed code. accessible_panels should now include 'seller'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{seller_email}}\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const token = json && json.data ? json.data.token : null;",
                  "if (token) { pm.collectionVariables.set('token', token); console.log('token saved'); }",
                  "pm.test('seller panel is accessible', () => pm.expect(pm.response.json().data.accessible_panels).to.include('seller'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Happy path (run in order)",
      "item": [
        {
          "name": "1. View my business profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/seller/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile"
              ]
            },
            "description": "Created automatically on approval. Bank fields are empty until step 3."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Full bank number never returned', () => {",
                  "    const bank = pm.response.json().data.bank;",
                  "    pm.expect(bank).to.not.have.property('account_number');",
                  "    if (bank.account_number_masked) pm.expect(bank.account_number_masked).to.match(/^\\*{4}.{4}$/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Update description + address",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
