        {
          "name": "6. Upload store logo (form-data)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/seller/profile/logo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile",
                "logo"
              ]
            },
            "description": "form-data: logo = select a JPG/PNG/WEBP up to 2 MB. Separate endpoint because PHP does not parse multipart bodies on PUT. The image goes through the same AI moderation as avatars.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "src": [],
                  "description": "JPG / PNG / WEBP, max 2 MB"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test('logo_url returned', () => pm.expect(pm.response.json().data.logo_url).to.be.a('string'));"
                ]
              }
            }
          ]
        },
