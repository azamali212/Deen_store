                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile"
              ]
            },
            "description": "Stored ENCRYPTED; the response only shows ****1234. Seller gets 'Payout bank account added' email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_account_title\": \"Zimal Fabrics\",\n  \"bank_name\": \"Meezan Bank\",\n  \"bank_account_number\": \"01234567891234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Full bank number never returned', () => {",
                  "    const bank = pm.response.json().data.bank;",
                  "    pm.expect(bank).to.not.have.property('account_number');",
                  "    if (bank.account_number_masked) pm.expect(bank.account_number_masked).to.match(/^\\*{4}.{4}$/);",
                  "});",
                  "pm.test('Masked ****1234', () => pm.expect(pm.response.json().data.bank.account_number_masked).to.eql('****1234'));"
                ]
              }
            }
          ]
