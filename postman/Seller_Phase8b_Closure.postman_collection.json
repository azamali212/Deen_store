        {
          "name": "1c. Close it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/seller/profile/close",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile",
                "close"
              ]
            },
            "description": "Owner only. Inside one transaction:\n  - status -> closed, closed_at + closure_reason recorded\n  - every OTHER team member loses their seller role\n  - the team ROWS are kept (C31) \u2014 nothing is deleted\n  - the OWNER keeps their seller role (C39)\n\nC39 is not an oversight. If the owner's role came off too they could not\nreach any seller route \u2014 including folder 3a, which is the only way to\nask for the store back. They would be locked out of their own exit.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seller_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm_store_name\": \"{{store_name}}\",\n  \"reason\": \"Moving to a physical shop.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Now closed\", () => pm.expect(d.status).to.eql('closed'));",
                  "console.log('closure:', JSON.stringify(d.closure));"
                ]
              }
            }
          ]
        },
        {
          "name": "1d. After \u2014 status and the closure block",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/seller/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "seller",
                "profile"
              ]
            },
            "description": "data.closure carries closed_at, reason and reopen_requested_at.\n\nNote it is a SEPARATE block from data.suspension. A reviewer must be\nable to see at a glance who ended this business.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seller_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
